<file path="public/content.css">
/* PostureSync Progressive Reversible Tab Intervention Styles */

/* Direct body blur ensures 100% reliable blur on any website regardless of stacking context */
html.posturesync-page-blurred > body {
  filter: blur(var(--posturesync-blur-amount, 3px)) !important;
  transition: filter 0.45s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

#posturesync-intervention-overlay {
  position: fixed !important;
  inset: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  z-index: 2147483645 !important;
  pointer-events: none !important;
  background-color: rgba(9, 14, 26, 0.42) !important;
  opacity: 0;
  transition: opacity 0.45s ease, backdrop-filter 0.45s ease, -webkit-backdrop-filter 0.45s ease !important;
}

#posturesync-intervention-overlay.posturesync-active {
  opacity: 1 !important;
}

#posturesync-intervention-pill {
  position: fixed !important;
  top: 22px !important;
  left: 50% !important;
  transform: translateX(-50%) translateY(-24px) !important;
  z-index: 2147483647 !important;
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  padding: 10px 20px !important;
  background: rgba(10, 15, 29, 0.95) !important;
  backdrop-filter: blur(18px) !important;
  -webkit-backdrop-filter: blur(18px) !important;
  border: 1px solid rgba(255, 255, 255, 0.16) !important;
  border-radius: 9999px !important;
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.7), 0 0 25px rgba(0, 0, 0, 0.4) !important;
  color: #f8fafc !important;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
  font-size: 13.5px !important;
  font-weight: 500 !important;
  line-height: 1.4 !important;
  pointer-events: auto !important;
  opacity: 0 !important;
  transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease !important;
  max-width: 90vw !important;
}

#posturesync-intervention-pill.posturesync-active {
  opacity: 1 !important;
  transform: translateX(-50%) translateY(0) !important;
}

/* Alert Level Specific Styling */
#posturesync-intervention-pill.level-1 {
  border-color: rgba(245, 158, 11, 0.65) !important;
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.65), 0 0 22px rgba(245, 158, 11, 0.3) !important;
}

#posturesync-intervention-pill.level-2 {
  border-color: rgba(249, 115, 22, 0.75) !important;
  box-shadow: 0 16px 38px rgba(0, 0, 0, 0.65), 0 0 26px rgba(249, 115, 22, 0.4) !important;
}

#posturesync-intervention-pill.level-3 {
  border-color: rgba(239, 68, 68, 0.9) !important;
  box-shadow: 0 18px 44px rgba(0, 0, 0, 0.75), 0 0 32px rgba(239, 68, 68, 0.5) !important;
}

#posturesync-intervention-pill.level-recovery {
  border-color: rgba(16, 185, 129, 0.75) !important;
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.65), 0 0 22px rgba(16, 185, 129, 0.35) !important;
}

#posturesync-intervention-pill.level-reminder {
  border-color: rgba(6, 182, 212, 0.7) !important;
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.65), 0 0 22px rgba(6, 182, 212, 0.3) !important;
}

.posturesync-pill-dot {
  width: 9px !important;
  height: 9px !important;
  border-radius: 50% !important;
  flex-shrink: 0 !important;
  transition: background-color 0.3s ease, box-shadow 0.3s ease !important;
}

.dot-level-1 {
  background-color: #f59e0b !important;
  box-shadow: 0 0 8px #f59e0b !important;
  animation: posturesync-pulse 2.2s infinite ease-in-out !important;
}

.dot-level-2 {
  background-color: #f97316 !important;
  box-shadow: 0 0 10px #f97316 !important;
  animation: posturesync-pulse 1.8s infinite ease-in-out !important;
}

.dot-level-3 {
  background-color: #ef4444 !important;
  box-shadow: 0 0 12px #ef4444 !important;
  animation: posturesync-pulse 1.2s infinite ease-in-out !important;
}

.dot-recovery {
  background-color: #10b981 !important;
  box-shadow: 0 0 8px #10b981 !important;
}

.dot-reminder {
  background-color: #06b6d4 !important;
  box-shadow: 0 0 8px #06b6d4 !important;
  animation: posturesync-pulse 2s infinite ease-in-out !important;
}

.posturesync-pill-badge {
  font-size: 11px !important;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
  padding: 3px 7px !important;
  border-radius: 5px !important;
  background: rgba(255, 255, 255, 0.12) !important;
  color: #94a3b8 !important;
  font-weight: 600 !important;
  white-space: nowrap !important;
}

.posturesync-pill-text {
  color: #f8fafc !important;
  font-weight: 500 !important;
}

.posturesync-pill-hint {
  font-size: 11px !important;
  font-weight: 600 !important;
  color: #94a3b8 !important;
  background: rgba(255, 255, 255, 0.08) !important;
  border: 1px solid rgba(255, 255, 255, 0.12) !important;
  border-radius: 9999px !important;
  padding: 3px 9px !important;
  white-space: nowrap !important;
  margin-left: 4px !important;
}

@keyframes posturesync-pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.3);
    opacity: 0.65;
  }
}

/* Dedicated Red Alert for Low Blink Rate */
#posturesync-blink-card {
  position: fixed !important;
  top: 20px !important;
  right: 24px !important;
  z-index: 2147483647 !important;
  width: 380px !important;
  max-width: calc(100vw - 48px) !important;
