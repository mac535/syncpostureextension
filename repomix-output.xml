        </p>

        <div style={{ display: 'flex', gap: '8px' }}>
          <button
            onClick={handleTriggerQuickCalibrate}
            disabled={isCalibrating}
            style={{
              flex: 1,
              background: 'rgba(56, 189, 248, 0.15)',
              border: '1px solid rgba(56, 189, 248, 0.35)',
              color: '#38bdf8',
              borderRadius: '5px',
              padding: '6px 10px',
              fontSize: '11px',
              fontWeight: 600,
              cursor: isCalibrating ? 'wait' : 'pointer'
