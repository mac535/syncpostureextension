          </button>
        </div>

        {/* Live Deviation Score Meter */}
        <div style={{ marginTop: '8px' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: '11px', color: '#94a3b8', marginBottom: '4px' }}>
            <span>Posture Deviation</span>
            <span style={{ fontWeight: 600, color: deviationPercent > 30 ? '#f43f5e' : '#10b981' }}>
              {deviationPercent}%
            </span>
          </div>
          <div style={{ width: '100%', height: '6px', background: 'rgba(255, 255, 255, 0.08)', borderRadius: '3px', overflow: 'hidden' }}>
            <div
              style={{
                width: `${deviationPercent}%`,
                height: '100%',
                backgroundColor: deviationPercent > 40 ? '#f43f5e' : deviationPercent > 20 ? '#fbbf24' : '#10b981',
                transition: 'width 0.3s ease, background-color 0.3s ease'
              }}
            />
          </div>
        </div>
      </div>

      {/* Real-Time Blink Tracking Card */}
      <div
        style={{
          background: 'rgba(15, 23, 42, 0.45)',
          border: '1px solid rgba(255, 255, 255, 0.08)',
          borderRadius: '8px',
          padding: '12px 14px',
          marginBottom: '12px'
        }}
      >
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '8px' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
            <Eye size={14} color="#38bdf8" />
            <span style={{ fontSize: '12px', fontWeight: 600 }}>Eye & Blink Tracking</span>
          </div>
          <span
            style={{
              fontSize: '10px',
              fontFamily: 'monospace',
              padding: '2px 6px',
              borderRadius: '4px',
              background:
                trackingStatus === 'reliable'
                  ? 'rgba(16, 185, 129, 0.15)'
                  : trackingStatus === 'unreliable'
                  ? 'rgba(245, 158, 11, 0.15)'
                  : 'rgba(148, 163, 184, 0.15)',
              color:
                trackingStatus === 'reliable'
                  ? '#10b981'
                  : trackingStatus === 'unreliable'
                  ? '#f59e0b'
                  : '#94a3b8',
              fontWeight: 600
            }}
          >
            {trackingStatus === 'reliable'
              ? 'Reliable Tracking'
              : trackingStatus === 'unreliable'
              ? 'Poor Lighting/Angle'
              : 'Searching Face...'}
          </span>
        </div>

        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '10px', marginTop: '6px' }}>
          <div style={{ background: 'rgba(0, 0, 0, 0.25)', borderRadius: '6px', padding: '8px' }}>
            <div style={{ fontSize: '10px', color: '#94a3b8' }}>Blink Rate</div>
            <div
              style={{
                fontSize: '15px',
                fontWeight: 700,
                color:
                  blinksPerMinute !== null && blinksPerMinute < (settings.lowBlinkRateThreshold || 10)
                    ? '#ef4444'
                    : '#38bdf8',
                marginTop: '2px'
              }}
            >
              {blinksPerMinute !== null
                ? `${blinksPerMinute} bpm`
                : `${Math.round(observationProgress * 100)}% sampled`}
            </div>
            <div style={{ fontSize: '9.5px', color: '#64748b', marginTop: '2px' }}>
              {blinksPerMinute !== null
                ? blinkRateStatus === 'low'
                  ? `Low rate (<${settings.lowBlinkRateThreshold || 10} bpm)`
                  : 'Normal rate (12-20 bpm)'
                : 'Collecting observations'}
            </div>
          </div>

          <div style={{ background: 'rgba(0, 0, 0, 0.25)', borderRadius: '6px', padding: '8px' }}>
            <div style={{ fontSize: '10px', color: '#94a3b8' }}>Blinks Counted</div>
            <div style={{ fontSize: '15px', fontWeight: 700, color: '#f8fafc', marginTop: '2px' }}>
              {blinkCount} <span style={{ fontSize: '10px', fontWeight: 400, color: '#94a3b8' }}>blinks</span>
            </div>
            <div style={{ fontSize: '9.5px', color: '#64748b', marginTop: '2px' }}>
              Real EAR Open-Close Cycle
            </div>
          </div>
        </div>

        {/* Observation Progress Bar (during initial window) */}
        {blinkRateStatus === 'collecting' && (
          <div style={{ marginTop: '8px' }}>
            <div
              style={{
                display: 'flex',
                justifyContent: 'space-between',
                fontSize: '10px',
                color: '#94a3b8',
                marginBottom: '3px'
              }}
            >
              <span>Observation Period ({settings.blinkObservationPeriodSec || 120}s)</span>
              <span style={{ color: '#38bdf8', fontWeight: 600 }}>
                {Math.round(observationProgress * 100)}%
              </span>
            </div>
            <div
              style={{
                width: '100%',
                height: '4px',
                background: 'rgba(255, 255, 255, 0.08)',
                borderRadius: '2px',
                overflow: 'hidden'
              }}
            >
              <div
                style={{
                  width: `${Math.round(observationProgress * 100)}%`,
                  height: '100%',
                  backgroundColor: '#38bdf8',
                  transition: 'width 0.3s ease'
                }}
              />
            </div>
          </div>
        )}

        {/* Blink Observation Duration Selector */}
        <div
          style={{
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            marginTop: '10px',
            paddingTop: '8px',
            borderTop: '1px solid rgba(255, 255, 255, 0.06)'
          }}
        >
          <span style={{ fontSize: '10px', color: '#94a3b8' }}>Observation Window</span>
          <div style={{ display: 'flex', gap: '3px' }}>
            {[
              { sec: 15, label: '15s (Test)' },
              { sec: 60, label: '60s' },
              { sec: 120, label: '2m (Def)' }
            ].map(({ sec, label }) => (
              <button
                key={sec}
                onClick={() => handleUpdateBlinkObservation(sec)}
                style={{
                  background:
                    (settings.blinkObservationPeriodSec || 120) === sec
                      ? '#0284c7'
                      : 'rgba(255, 255, 255, 0.05)',
                  border: `1px solid ${
                    (settings.blinkObservationPeriodSec || 120) === sec
                      ? '#38bdf8'
                      : 'rgba(255, 255, 255, 0.1)'
                  }`,
                  color: (settings.blinkObservationPeriodSec || 120) === sec ? '#fff' : '#94a3b8',
                  borderRadius: '3px',
                  padding: '2px 5px',
                  fontSize: '9.5px',
                  fontWeight: 600,
                  cursor: 'pointer'
                }}
              >
                {label}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Screen Session Break Reminder Card */}
      <div
        style={{
          background: 'rgba(15, 23, 42, 0.45)',
          border: '1px solid rgba(255, 255, 255, 0.08)',
          borderRadius: '8px',
          padding: '12px 14px',
          marginBottom: '12px'
        }}
      >
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '8px' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
            <Coffee size={14} color="#f59e0b" />
            <span style={{ fontSize: '12px', fontWeight: 600 }}>Screen Session Break</span>
          </div>
          <span
            style={{
              fontSize: '10.5px',
              fontFamily: 'monospace',
              padding: '2px 6px',
              borderRadius: '4px',
              background: isBreakActive
                ? 'rgba(239, 68, 68, 0.25)'
                : monitoringActive
                ? 'rgba(56, 189, 248, 0.15)'
                : 'rgba(148, 163, 184, 0.15)',
              color: isBreakActive ? '#ef4444' : monitoringActive ? '#38bdf8' : '#94a3b8',
              fontWeight: 700
            }}
          >
            {isBreakActive
              ? 'BREAK DUE!'
              : monitoringActive
              ? formatRemainingTime(breakRemainingMs)
              : 'Timer Inactive'}
          </span>
        </div>

        {isBreakActive && (
          <div
            style={{
              background: 'rgba(239, 68, 68, 0.15)',
              border: '1px solid rgba(239, 68, 68, 0.4)',
              borderRadius: '6px',
              padding: '8px',
              marginBottom: '8px',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              gap: '6px'
            }}
          >
            <span style={{ fontSize: '10.5px', color: '#fca5a5' }}>
              Break alert active on active tabs!
            </span>
            <div style={{ display: 'flex', gap: '4px' }}>
              <button
                onClick={handleDismissBreak}
                style={{
                  background: '#10b981',
                  border: 'none',
                  color: '#fff',
                  borderRadius: '4px',
                  padding: '3px 8px',
                  fontSize: '10px',
                  fontWeight: 600,
                  cursor: 'pointer'
                }}
              >
                Dismiss
              </button>
              <button
                onClick={() => handleSnoozeBreak(5)}
                style={{
                  background: 'rgba(255, 255, 255, 0.15)',
                  border: 'none',
                  color: '#cbd5e1',
                  borderRadius: '4px',
                  padding: '3px 8px',
                  fontSize: '10px',
                  cursor: 'pointer'
                }}
              >
                Snooze 5m
              </button>
            </div>
          </div>
        )}

        {/* Break Interval Selector */}
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginTop: '6px' }}>
          <span style={{ fontSize: '11px', color: '#cbd5e1' }}>Break Interval</span>
          <div style={{ display: 'flex', gap: '3px' }}>
            {[
              { min: 1, label: '1m (Test)' },
              { min: 15, label: '15m' },
              { min: 30, label: '30m (Def)' },
              { min: 60, label: '60m' }
            ].map(({ min, label }) => (
              <button
                key={min}
                onClick={() => handleUpdateBreakInterval(min)}
                style={{
                  background:
                    (settings.breakIntervalMin || 30) === min
                      ? '#0284c7'
                      : 'rgba(255, 255, 255, 0.05)',
                  border: `1px solid ${
                    (settings.breakIntervalMin || 30) === min
                      ? '#38bdf8'
                      : 'rgba(255, 255, 255, 0.1)'
                  }`,
                  color: (settings.breakIntervalMin || 30) === min ? '#fff' : '#94a3b8',
                  borderRadius: '4px',
                  padding: '3px 6px',
                  fontSize: '10px',
                  fontWeight: 600,
                  cursor: 'pointer'
                }}
              >
                {label}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Progressive Blur & Escalation Status */}
      <div
        style={{
          background: 'rgba(15, 23, 42, 0.45)',
          border: '1px solid rgba(255, 255, 255, 0.08)',
          borderRadius: '8px',
          padding: '12px 14px',
          marginBottom: '12px'
        }}
      >
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '8px' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
            <Sparkles size={14} color="#f59e0b" />
            <span style={{ fontSize: '12px', fontWeight: 600 }}>Progressive Webpage Blur</span>
          </div>
          <span
            style={{
              fontSize: '10.5px',
              fontFamily: 'monospace',
              padding: '2px 6px',
              borderRadius: '4px',
              background: blurPx > 0 ? 'rgba(244, 63, 94, 0.2)' : 'rgba(16, 185, 129, 0.15)',
              color: blurPx > 0 ? '#f43f5e' : '#10b981',
              fontWeight: 700
            }}
          >
            {blurPx > 0 ? `${blurPx}px Active` : '0px (Clear)'}
          </span>
        </div>

        <div style={{ display: 'flex', gap: '4px', marginTop: '8px' }}>
          <div style={{ flex: 1, padding: '5px', borderRadius: '4px', background: alertLevel >= 1 ? 'rgba(245, 158, 11, 0.25)' : 'rgba(255, 255, 255, 0.04)', border: `1px solid ${alertLevel >= 1 ? '#f59e0b' : 'transparent'}`, textAlign: 'center' }}>
            <div style={{ fontSize: '9px', color: '#94a3b8' }}>Level 1</div>
            <div style={{ fontSize: '11px', fontWeight: 700, color: alertLevel >= 1 ? '#f59e0b' : '#64748b' }}>3px</div>
          </div>
          <div style={{ flex: 1, padding: '5px', borderRadius: '4px', background: alertLevel >= 2 ? 'rgba(249, 115, 22, 0.25)' : 'rgba(255, 255, 255, 0.04)', border: `1px solid ${alertLevel >= 2 ? '#f97316' : 'transparent'}`, textAlign: 'center' }}>
            <div style={{ fontSize: '9px', color: '#94a3b8' }}>Level 2</div>
            <div style={{ fontSize: '11px', fontWeight: 700, color: alertLevel >= 2 ? '#f97316' : '#64748b' }}>6px</div>
          </div>
          <div style={{ flex: 1, padding: '5px', borderRadius: '4px', background: alertLevel >= 3 ? 'rgba(239, 68, 68, 0.25)' : 'rgba(255, 255, 255, 0.04)', border: `1px solid ${alertLevel >= 3 ? '#ef4444' : 'transparent'}`, textAlign: 'center' }}>
            <div style={{ fontSize: '9px', color: '#94a3b8' }}>Level 3</div>
            <div style={{ fontSize: '11px', fontWeight: 700, color: alertLevel >= 3 ? '#ef4444' : '#64748b' }}>11px</div>
          </div>
        </div>
      </div>

      {/* Posture Calibration Section */}
      <div
        style={{
          background: 'rgba(15, 23, 42, 0.45)',
          border: '1px solid rgba(255, 255, 255, 0.08)',
          borderRadius: '8px',
          padding: '12px 14px',
          marginBottom: '12px'
        }}
      >
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>
            {baseline ? <CheckCircle2 size={14} color="#10b981" /> : <Sliders size={14} color="#38bdf8" />}
            <span style={{ fontSize: '12px', fontWeight: 600 }}>Ergonomic Calibration</span>
          </div>
          <span style={{ fontSize: '10px', color: baseline ? '#10b981' : '#94a3b8' }}>
            {baseline ? 'Calibrated' : 'Default Model'}
          </span>
