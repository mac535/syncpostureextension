            border: '1px solid var(--ink-border)',
            borderRadius: '4px',
            padding: '2.25rem 2rem',
            textAlign: 'center',
            display: 'flex',
            flexDirection: 'column',
            alignItems: 'center'
          }}
        >
          <div
            style={{
              width: '50px',
              height: '50px',
              borderRadius: '50%',
              backgroundColor: 'rgba(255, 107, 74, 0.15)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              color: 'var(--signal-alert)',
              marginBottom: '1.25rem'
            }}
          >
            <ShieldAlert size={26} />
          </div>

          <div
            style={{
              fontFamily: 'var(--font-mono)',
              fontSize: '0.75rem',
              letterSpacing: '0.08em',
              color: 'var(--signal-alert)',
              marginBottom: '0.5rem',
              fontWeight: 600
            }}
          >
            POSTURE SETUP REQUIRED
          </div>

          <h1
            style={{
              fontSize: '1.35rem',
              fontWeight: 600,
              lineHeight: 1.35,
              color: 'var(--ink-text)',
              margin: '0 0 1rem'
            }}
          >
            Guided posture setup must be completed first.
          </h1>

          <p
            style={{
              fontFamily: 'var(--font-display)',
              fontSize: '0.9rem',
              lineHeight: 1.6,
              color: 'var(--ink-muted)',
              margin: '0 0 2rem'
            }}
          >
            Complete the guided posture setup in Dashboard before starting the intervention demo.
          </p>

          <Link
            to="/dashboard"
            className="btn btn-primary"
            style={{
              width: '100%',
              padding: '0.75rem 1.25rem',
              fontFamily: 'var(--font-display)',
              fontSize: '0.9rem'
            }}
          >
            Open Posture Dashboard
          </Link>
        </div>
      </div>
    );
  }

  return (
    <div className="qp-page" style={{ position: 'relative' }}>
      {/* Subtle vignette overlay — visual only, no text, pointer-events none */}
      <div
        className="intervention-overlay"
        style={{ opacity: visualParams.vignette, pointerEvents: 'none' }}
        aria-hidden="true"
      />

      {/* Main Content Area — scrolling remains 100% active, filter applies visually */}
      <div className="demo-content-wrapper" style={contentStyle}>
        <Header />
        <Hero />
        <Features />
        <Discovery />
        <Journal />
        <FinalCTA />
        <Footer />
      </div>
    </div>
  );
};
