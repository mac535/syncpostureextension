@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap');

:root {
  /* Quiet Place Palette */
  --qp-sage: #DCEBE4;
  --qp-mint: #EAF3EE;
  --qp-cream: #F8F3E8;
  --qp-cream-light: #FCFAF5;
  --qp-forest: #173B35;
  --qp-forest-muted: #365B51;
  --qp-green-muted: #78958B;
  --qp-coral: #E96F67;
  --qp-coral-hover: #DC5E56;
  --qp-coral-soft: #F4A09A;
  --qp-sand: #EFE8D8;
  --qp-border: rgba(23, 59, 53, 0.1);
  --qp-border-light: rgba(23, 59, 53, 0.06);

  /* Spacing rhythm */
  --space-8: 8px;
  --space-12: 12px;
  --space-16: 16px;
  --space-24: 24px;
  --space-32: 32px;
  --space-48: 48px;
  --space-64: 64px;
  --space-80: 80px;
  --space-96: 96px;
  --space-120: 120px;

  /* Quiet Place Typography */
  --font-serif: Georgia, 'Times New Roman', Cambria, serif;
  --font-sans: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

  /* syncPosture Design System Tokens */
  --ink-bg: #0F2138;
  --ink-panel: #16304A;
  --ink-border: #2C4A66;
  --ink-text: #E7EEF3;
  --ink-muted: #8CA6BC;
  --signal-alert: #FF6B4A;
  --signal-good: #4FD8C4;

  --font-display: 'IBM Plex Sans', system-ui, sans-serif;
  --font-mono: 'IBM Plex Mono', ui-monospace, monospace;

  /* Legacy variable mappings for backward compatibility */
  --bg-primary: var(--ink-bg);
  --bg-secondary: var(--ink-panel);
  --bg-card: var(--ink-panel);
  --bg-card-border: var(--ink-border);
  --text-main: var(--ink-text);
  --text-muted: var(--ink-muted);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-display);
  background-color: var(--ink-bg);
  color: var(--ink-text);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

