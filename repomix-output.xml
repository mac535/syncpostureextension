import React from 'react';
import { BrowserRouter, Routes, Route, NavLink } from 'react-router-dom';
import { Home } from './pages/Home';
import { Dashboard } from './pages/Dashboard';
import { Demo } from './pages/Demo';
import { Activity, LayoutDashboard, Home as HomeIcon } from 'lucide-react';

export const App: React.FC = () => {
  return (
    <BrowserRouter>
      <div style={{ display: 'flex', flexDirection: 'column', minHeight: '100vh' }}>
        {/* Navigation Bar */}
        <header className="top-nav">
          <NavLink to="/" className="brand-badge">
            <span className="nav-status-dot" aria-label="Monitoring capability available" />
            <span>syncPosture</span>
          </NavLink>

          <nav className="nav-links">
            <NavLink to="/" className={({ isActive }) => `nav-link ${isActive ? 'active' : ''}`} end>
              <HomeIcon size={15} />
              <span>Home</span>
            </NavLink>
            <NavLink to="/dashboard" className={({ isActive }) => `nav-link ${isActive ? 'active' : ''}`}>
              <Activity size={15} />
              <span>Dashboard</span>
            </NavLink>
            <NavLink to="/demo" className={({ isActive }) => `nav-link ${isActive ? 'active' : ''}`}>
              <LayoutDashboard size={15} />
              <span>Demo</span>
            </NavLink>
          </nav>
        </header>

        {/* Routes */}
        <main style={{ flex: 1 }}>
          <Routes>
            <Route path="/" element={<Home />} />
            <Route path="/dashboard" element={<Dashboard />} />
            <Route path="/demo" element={<Demo />} />
          </Routes>
        </main>
      </div>
    </BrowserRouter>
  );
};

export default App;
</file>

<file path="src/index.css">
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap');

:root {
  /* Quiet Place Palette */
  --qp-sage: #DCEBE4;
  --qp-mint: #EAF3EE;
  --qp-cream: #F8F3E8;
  --qp-cream-light: #FCFAF5;
  --qp-forest: #173B35;
  --qp-forest-muted: #365B51;
  --qp-green-muted: #78958B;
  --qp-coral: #E96F67;
  --qp-coral-hover: #DC5E56;
  --qp-coral-soft: #F4A09A;
  --qp-sand: #EFE8D8;
  --qp-border: rgba(23, 59, 53, 0.1);
  --qp-border-light: rgba(23, 59, 53, 0.06);

  /* Spacing rhythm */
  --space-8: 8px;
  --space-12: 12px;
  --space-16: 16px;
  --space-24: 24px;
  --space-32: 32px;
  --space-48: 48px;
  --space-64: 64px;
  --space-80: 80px;
  --space-96: 96px;
  --space-120: 120px;

  /* Quiet Place Typography */
  --font-serif: Georgia, 'Times New Roman', Cambria, serif;
  --font-sans: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

  /* syncPosture Design System Tokens */
  --ink-bg: #0F2138;
  --ink-panel: #16304A;
  --ink-border: #2C4A66;
  --ink-text: #E7EEF3;
  --ink-muted: #8CA6BC;
  --signal-alert: #FF6B4A;
  --signal-good: #4FD8C4;

  --font-display: 'IBM Plex Sans', system-ui, sans-serif;
  --font-mono: 'IBM Plex Mono', ui-monospace, monospace;

  /* Legacy variable mappings for backward compatibility */
  --bg-primary: var(--ink-bg);
  --bg-secondary: var(--ink-panel);
  --bg-card: var(--ink-panel);
  --bg-card-border: var(--ink-border);
  --text-main: var(--ink-text);
  --text-muted: var(--ink-muted);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-display);
  background-color: var(--ink-bg);
  color: var(--ink-text);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

a {
  color: inherit;
  text-decoration: none;
}

/* ==========================================================
   QUIET PLACE FOUNDATION & LAYOUT SYSTEM (/demo)
   ========================================================== */

.qp-page {
  background-color: var(--qp-cream-light);
  color: var(--qp-forest);
  font-family: var(--font-sans);
  min-height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
}

.qp-container {
  width: 100%;
  max-width: 1240px;
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--space-24);
  padding-right: var(--space-24);
}

@media (min-width: 1024px) {
  .qp-container {
    padding-left: var(--space-32);
    padding-right: var(--space-32);
  }
}

/* Typography styles for Quiet Place */
.qp-serif {
  font-family: var(--font-serif);
}

.qp-heading-1 {
  font-family: var(--font-serif);
  font-size: 2.75rem;
  line-height: 1.15;
  font-weight: 400;
  color: var(--qp-forest);
  letter-spacing: -0.01em;
}

.qp-heading-2 {
  font-family: var(--font-serif);
  font-size: 2rem;
  line-height: 1.25;
  font-weight: 400;
  color: var(--qp-forest);
}

.qp-heading-3 {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  line-height: 1.35;
  font-weight: 400;
  color: var(--qp-forest);
}

.qp-body {
  font-family: var(--font-sans);
  font-size: 1rem;
  line-height: 1.65;
  color: var(--qp-forest-muted);
}

.qp-body-sm {
  font-family: var(--font-sans);
  font-size: 0.875rem;
  line-height: 1.5;
  color: var(--qp-forest-muted);
}

/* ==========================================================
   QUIET PLACE HEADER & NAVIGATION
   ========================================================== */

.qp-header-wrapper {
  background-color: var(--qp-cream-light);
  border-bottom: 1px solid var(--qp-border-light);
  position: sticky;
  top: 0;
  z-index: 30;
}

.qp-header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80px;
}

/* Logo */
.qp-brand {
  display: flex;
  align-items: center;
  gap: var(--space-12);
  cursor: pointer;
  user-select: none;
}

.qp-brand-mark {
  width: 34px;
  height: 34px;
  background-color: var(--qp-sage);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--qp-forest);
  transition: transform 0.25s ease, background-color 0.25s ease;
}

.qp-brand:hover .qp-brand-mark {
  transform: rotate(8deg);
  background-color: var(--qp-mint);
}

.qp-brand-text {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  font-weight: 400;
  color: var(--qp-forest);
  letter-spacing: -0.01em;
}

/* Main Navigation */
.qp-nav {
  display: flex;
  align-items: center;
  gap: var(--space-32);
}

.qp-nav-link {
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--qp-forest-muted);
  position: relative;
  padding: 6px 0;
  transition: color 200ms ease;
}

.qp-nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0%;
  height: 1.5px;
  background-color: var(--qp-forest);
  transition: width 200ms ease;
}

.qp-nav-link:hover {
  color: var(--qp-forest);
}

.qp-nav-link:hover::after {
  width: 100%;
}

/* Header Right Actions */
.qp-actions {
  display: flex;
  align-items: center;
  gap: var(--space-24);
}

.qp-icon-btn {
  background: none;
  border: none;
  color: var(--qp-forest-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  transition: all 200ms ease;
}

.qp-icon-btn:hover {
  color: var(--qp-forest);
  background-color: var(--qp-sage);
}

.qp-signin-btn {
  background: none;
  border: none;
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--qp-forest);
  cursor: pointer;
  padding: 6px var(--space-8);
  transition: color 200ms ease;
}

.qp-signin-btn:hover {
  color: var(--qp-forest-muted);
}

/* Primary Coral CTA Button */
.qp-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-8);
  background-color: var(--qp-coral);
  color: #ffffff;
  padding: 10px var(--space-24);
  border-radius: 9999px;
  font-size: 0.925rem;
  font-weight: 500;
  border: none;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(233, 111, 103, 0.25);
  transition: transform 200ms ease, background-color 200ms ease, box-shadow 200ms ease;
}

.qp-cta-btn:hover {
  background-color: var(--qp-coral-hover);
  transform: translateY(-1px);
  box-shadow: 0 4px 14px rgba(233, 111, 103, 0.35);
}

.qp-cta-btn:active {
  transform: translateY(0);
}

/* Mobile Nav Toggle */
.qp-mobile-toggle {
  display: none;
  background: none;
  border: none;
  color: var(--qp-forest);
  cursor: pointer;
  padding: var(--space-8);
  border-radius: 6px;
}

@media (max-width: 860px) {
  .qp-nav {
    display: none;
  }
  .qp-signin-btn {
    display: none;
  }
  .qp-mobile-toggle {
    display: flex;
  }
  .qp-header-inner {
    height: 70px;
  }
}

@media (max-width: 540px) {
  .qp-cta-btn {
    padding: 8px var(--space-16);
    font-size: 0.85rem;
  }
}

/* Mobile dropdown menu */
.qp-mobile-menu {
  display: flex;
  flex-direction: column;
  background-color: var(--qp-cream-light);
  border-bottom: 1px solid var(--qp-border);
  padding: var(--space-16) var(--space-24) var(--space-24);
  gap: var(--space-16);
}

.qp-mobile-menu .qp-nav-link {
  font-size: 1.05rem;
  padding: var(--space-8) 0;
  border-bottom: 1px solid var(--qp-border-light);
}

/* ==========================================================
   QUIET PLACE HERO SECTION
   ========================================================== */

.qp-hero-section {
  padding-top: var(--space-64);
  padding-bottom: var(--space-64);
  background-color: var(--qp-cream-light);
}

.qp-eyebrow {
  display: inline-block;
  font-size: 0.875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--qp-green-muted);
  margin-bottom: var(--space-16);
}

.qp-hero-title {
  font-family: var(--font-serif);
  font-size: clamp(2.4rem, 4.2vw, 3.75rem);
  line-height: 1.15;
  font-weight: 400;
  color: var(--qp-forest);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-24);
}

.qp-hero-desc {
  font-family: var(--font-sans);
  font-size: clamp(1rem, 1.3vw, 1.15rem);
  line-height: 1.65;
  color: var(--qp-forest-muted);
  max-width: 580px;
  margin: 0 auto var(--space-32);
}

.qp-hero-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-16);
  margin-bottom: var(--space-48);
  flex-wrap: wrap;
}

.qp-hero-secondary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 24px;
  border-radius: 9999px;
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--qp-forest);
  background-color: transparent;
  border: 1px solid var(--qp-border);
  cursor: pointer;
  transition: all 200ms ease;
}

.qp-hero-secondary-btn:hover {
  background-color: var(--qp-sand);
  border-color: rgba(23, 59, 53, 0.2);
  color: var(--qp-forest);
}

.qp-hero-landscape-wrapper {
  width: 100%;
  max-width: 1180px;
  margin: 0 auto;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 16px 36px -10px rgba(23, 59, 53, 0.12), 0 0 0 1px rgba(23, 59, 53, 0.05);
}

.qp-landscape-svg {
  width: 100%;
  height: auto;
  display: block;
}

/* ==========================================================
   QUIET PLACE FEATURES / PHILOSOPHY SECTION
   ========================================================== */

.qp-features-section {
  padding-top: var(--space-80);
  padding-bottom: var(--space-96);
  background-color: var(--qp-cream-light);
}

.qp-features-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto var(--space-64);
}

.qp-features-title {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 3.2vw, 2.75rem);
  line-height: 1.2;
  font-weight: 400;
  color: var(--qp-forest);
  margin-bottom: var(--space-16);
  letter-spacing: -0.01em;
}

.qp-features-subtitle {
  font-family: var(--font-sans);
  font-size: 1.05rem;
  line-height: 1.65;
  color: var(--qp-forest-muted);
}

.qp-features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-24);
}

@media (max-width: 960px) {
  .qp-features-grid {
    grid-template-columns: 1fr;
    gap: var(--space-24);
  }
}

.qp-feature-card {
  padding: var(--space-32) var(--space-32) var(--space-48);
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 280px;
  border: 1px solid var(--qp-border);
  transition: transform 250ms ease, box-shadow 250ms ease, border-color 250ms ease;
  position: relative;
  cursor: pointer;
}

.qp-feature-card-cream {
  background-color: var(--qp-cream);
}

.qp-feature-card-mint {
  background-color: var(--qp-mint);
}

.qp-feature-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 24px -6px rgba(23, 59, 53, 0.08);
  border-color: rgba(23, 59, 53, 0.2);
}

.qp-feature-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-32);
}

.qp-feature-number {
  font-family: var(--font-serif);
  font-size: 1.15rem;
  color: var(--qp-green-muted);
  font-weight: 400;
}

.qp-feature-icon-box {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background-color: var(--qp-sage);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--qp-forest);
  transition: background-color 200ms ease, transform 200ms ease;
}

.qp-feature-card:hover .qp-feature-icon-box {
  background-color: #ffffff;
  transform: scale(1.05);
}

.qp-feature-card-title {
  font-family: var(--font-serif);
  font-size: 1.45rem;
  font-weight: 400;
  color: var(--qp-forest);
  margin-bottom: var(--space-12);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: color 200ms ease;
}

.qp-feature-card:hover .qp-feature-card-title {
  color: var(--qp-coral);
}

.qp-feature-arrow {
  color: var(--qp-green-muted);
  opacity: 0.6;
  transform: translate(0, 0);
  transition: all 200ms ease;
}

.qp-feature-card:hover .qp-feature-arrow {
  opacity: 1;
  color: var(--qp-coral);
  transform: translate(2px, -2px);
}

.qp-feature-card-desc {
  font-size: 0.95rem;
  line-height: 1.6;
  color: var(--qp-forest-muted);
}

/* ==========================================================
   QUIET PLACE DISCOVERY SECTION
   ========================================================== */

.qp-discovery-section {
  padding-top: var(--space-80);
  padding-bottom: var(--space-96);
  background-color: var(--qp-cream);
}

.qp-discovery-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: var(--space-48);
  flex-wrap: wrap;
  gap: var(--space-24);
}

.qp-view-all-link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-8);
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--qp-forest);
  padding: 6px 0;
  transition: color 200ms ease, transform 200ms ease;
}

.qp-view-all-link:hover {
  color: var(--qp-coral);
  transform: translateX(3px);
}

.qp-discovery-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  grid-template-rows: auto auto;
  gap: var(--space-24);
}

.qp-discovery-subgrid {
  display: flex;
  flex-direction: column;
  gap: var(--space-24);
}

.qp-place-card {
  background-color: var(--qp-cream-light);
  border: 1px solid var(--qp-border);
  border-radius: 18px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 250ms ease, box-shadow 250ms ease, border-color 250ms ease;
  cursor: pointer;
}

.qp-place-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 28px -8px rgba(23, 59, 53, 0.08);
  border-color: rgba(23, 59, 53, 0.2);
}

.qp-place-img-box {
  width: 100%;
  overflow: hidden;
  background-color: var(--qp-mint);
  display: flex;
  align-items: center;
  justify-content: center;
}

.qp-card-svg {
  width: 100%;
  height: auto;
  display: block;
  transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
}

.qp-place-card:hover .qp-card-svg {
  transform: scale(1.02);
}

.qp-place-meta {
  padding: var(--space-24) var(--space-24) var(--space-32);
  display: flex;
  flex-direction: column;
  flex: 1;
}

.qp-place-category {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--qp-green-muted);
  text-transform: uppercase;
  margin-bottom: var(--space-8);
}

.qp-place-title {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  font-weight: 400;
  color: var(--qp-forest);
  margin-bottom: var(--space-8);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: color 200ms ease;
}

.qp-place-card:hover .qp-place-title {
  color: var(--qp-coral);
}

.qp-place-arrow {
  color: var(--qp-green-muted);
  opacity: 0.6;
  transition: all 200ms ease;
}

.qp-place-card:hover .qp-place-arrow {
  opacity: 1;
  color: var(--qp-coral);
  transform: translate(2px, -2px);
}

.qp-place-desc {
  font-size: 0.925rem;
  line-height: 1.55;
  color: var(--qp-forest-muted);
}

.qp-place-wide {
  grid-column: 1 / -1;
}

@media (max-width: 900px) {
  .qp-discovery-grid {
    grid-template-columns: 1fr;
  }
  .qp-place-wide {
    grid-column: auto;
  }
}

/* ==========================================================
   QUIET PLACE JOURNAL SECTION
   ========================================================== */

.qp-journal-section {
  padding-top: var(--space-80);
  padding-bottom: var(--space-96);
  background-color: var(--qp-mint);
}

.qp-journal-header {
  margin-bottom: var(--space-48);
}

.qp-journal-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: var(--space-32);
}

@media (max-width: 960px) {
  .qp-journal-grid {
    grid-template-columns: 1fr;
  }
}

.qp-journal-card {
  background-color: var(--qp-cream-light);
  border: 1px solid var(--qp-border);
  border-radius: 18px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 250ms ease, box-shadow 250ms ease, border-color 250ms ease;
  cursor: pointer;
}

.qp-journal-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 28px -8px rgba(23, 59, 53, 0.08);
  border-color: rgba(23, 59, 53, 0.2);
}

.qp-journal-featured-art {
  width: 100%;
  overflow: hidden;
  background-color: var(--qp-sand);
}

.qp-journal-card:hover .qp-journal-featured-art svg {
  transform: scale(1.02);
}

.qp-journal-side-stack {
  display: flex;
  flex-direction: column;
  gap: var(--space-24);
}

.qp-journal-content {
  padding: var(--space-32);
  display: flex;
  flex-direction: column;
  flex: 1;
}

.qp-journal-meta {
  display: flex;
  align-items: center;
  gap: var(--space-16);
  margin-bottom: var(--space-12);
}

.qp-journal-cat {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--qp-green-muted);
  text-transform: uppercase;
}

.qp-journal-time {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.8rem;
  color: var(--qp-forest-muted);
}

.qp-journal-title {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  line-height: 1.35;
  font-weight: 400;
  color: var(--qp-forest);
  margin-bottom: var(--space-12);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-12);
  transition: color 200ms ease;
}

.qp-journal-featured-title {
  font-size: 1.7rem;
}

.qp-journal-card:hover .qp-journal-title {
  color: var(--qp-coral);
}

.qp-journal-arrow {
  color: var(--qp-green-muted);
  opacity: 0.6;
  flex-shrink: 0;
  margin-top: 4px;
  transition: all 200ms ease;
}

.qp-journal-card:hover .qp-journal-arrow {
  opacity: 1;
  color: var(--qp-coral);
  transform: translate(2px, -2px);
}

.qp-journal-excerpt {
  font-size: 0.95rem;
  line-height: 1.6;
  color: var(--qp-forest-muted);
}

/* ==========================================================
   QUIET PLACE FINAL CTA SECTION
   ========================================================== */

.qp-cta-section {
  padding-top: var(--space-48);
  padding-bottom: var(--space-80);
  background-color: var(--qp-mint);
}

.qp-cta-box {
  background-color: var(--qp-forest);
  border-radius: 24px;
  position: relative;
  overflow: hidden;
  padding: var(--space-80) var(--space-32);
  text-align: center;
  box-shadow: 0 20px 40px -12px rgba(23, 59, 53, 0.25);
}

.qp-cta-decor {
  position: absolute;
  inset: 0;
  pointer-events: none;
  width: 100%;
  height: 100%;
}

.qp-cta-inner {
  position: relative;
  z-index: 2;
  max-width: 620px;
  margin: 0 auto;
}

.qp-cta-title {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 3.5vw, 2.75rem);
  line-height: 1.2;
  font-weight: 400;
  color: #FCFAF5;
  letter-spacing: -0.01em;
  margin-bottom: var(--space-16);
}

.qp-cta-desc {
  font-family: var(--font-sans);
  font-size: 1.1rem;
  line-height: 1.6;
  color: var(--qp-sage);
  margin-bottom: var(--space-32);
}

.qp-cta-btn-large {
  padding: 13px 32px;
  font-size: 1rem;
}

/* ==========================================================
   QUIET PLACE FOOTER SECTION
   ========================================================== */

.qp-footer-wrapper {
  background-color: var(--qp-cream-light);
  border-top: 1px solid var(--qp-border);
  padding-top: var(--space-64);
  padding-bottom: var(--space-48);
}

.qp-footer-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-48);
  margin-bottom: var(--space-48);
  flex-wrap: wrap;
}

.qp-footer-brand-col {
  max-width: 380px;
}

.qp-footer-tagline {
  font-size: 0.925rem;
  line-height: 1.6;
  color: var(--qp-forest-muted);
}

.qp-footer-links-grid {
  display: flex;
  gap: var(--space-64);
}

@media (max-width: 640px) {
  .qp-footer-links-grid {
    gap: var(--space-32);
  }
}

.qp-footer-col {
  display: flex;
  flex-direction: column;
  gap: var(--space-12);
}

.qp-footer-col-title {
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--qp-forest);
  margin-bottom: var(--space-4);
}

.qp-footer-link {
  font-size: 0.925rem;
  color: var(--qp-forest-muted);
  transition: color 150ms ease;
}

.qp-footer-link:hover {
  color: var(--qp-forest);
}

.qp-footer-bottom {
  border-top: 1px solid var(--qp-border-light);
  padding-top: var(--space-24);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-16);
}

.qp-footer-copy {
  font-size: 0.85rem;
  color: var(--qp-green-muted);
}

.qp-footer-meta-pill {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--qp-green-muted);
  background-color: var(--qp-sand);
  padding: 4px 10px;
  border-radius: 9999px;
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ==========================================================
   DEGRADATION & BLUR INTERVENTION STYLING
   ========================================================== */

.demo-content-wrapper {
  transition: filter 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s ease;
  position: relative;
  flex: 1;
}

.demo-content-wrapper.blurred {
  filter: blur(14px) brightness(0.7) saturate(0.8);
  pointer-events: none;
  user-select: none;
}

.intervention-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle, transparent 40%, rgba(233, 111, 103, 0.35) 100%);
  animation: pulse-vignette 2.4s infinite alternate ease-in-out;
}

@keyframes pulse-vignette {
  0% {
    background: radial-gradient(circle, transparent 45%, rgba(233, 111, 103, 0.2) 100%);
  }
  100% {
    background: radial-gradient(circle, transparent 35%, rgba(233, 111, 103, 0.45) 100%);
  }
}

/* ==========================================================
   APP SHELL / DASHBOARD STYLING (Technical Instrument Panel)
   ========================================================== */

/* Flat technical panel: 1px hairline border, max 4px radius, no blur/glow */
.glass-panel {
  background: var(--ink-panel);
  border: 1px solid var(--ink-border);
  border-radius: 4px;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

/* Technical top navigation */
.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1.5rem;
  border-bottom: 1px solid var(--ink-border);
  background: var(--ink-bg);
  position: sticky;
  top: 0;
  z-index: 40;
  font-family: var(--font-display);
}

/* Technical brand badge - plain font-mono wordmark in --ink-text */
.brand-badge {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-weight: 500;
  font-size: 1rem;
  letter-spacing: -0.02em;
  color: var(--ink-text);
  background: none;
  -webkit-background-clip: unset;
  -webkit-text-fill-color: var(--ink-text);
  text-decoration: none;
}

/* Status indicator: 6px dot in --signal-good with subtle pulse */
.nav-status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: var(--signal-good);
  display: inline-block;
  animation: pulse-status 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes pulse-status {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.45;
    transform: scale(0.85);
  }
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

/* Nav links: 1px bottom-border underline on hover/active, --font-display, no background fill */
.nav-link {
  padding: 0.4rem 0;
  border-radius: 0;
  border: none;
  border-bottom: 1px solid transparent;
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--ink-muted);
  background: transparent !important;
  transition: color 0.15s ease, border-color 0.15s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}

.nav-link:hover {
  color: var(--ink-text);
  border-bottom-color: var(--ink-text);
}

.nav-link.active {
  color: var(--ink-text);
  border-bottom-color: var(--ink-text);
}

.nav-link svg {
  color: var(--ink-muted);
  transition: color 0.15s ease;
}

.nav-link:hover svg,
.nav-link.active svg {
  color: var(--ink-text);
}

/* Technical buttons: flat, 1px border, max 4px radius, no gradients, no glows */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 600;
  border-radius: 4px;
  border: 1px solid transparent;
  cursor: pointer;
  transition: opacity 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  box-shadow: none;
  text-decoration: none;
}

.btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

/* Primary = solid --ink-text background with --ink-bg text (inverted, high contrast) */
.btn-primary {
  background: var(--ink-text);
  color: var(--ink-bg);
  border-color: var(--ink-text);
  box-shadow: none;
}

.btn-primary:hover:not(:disabled) {
  transform: none;
  box-shadow: none;
  opacity: 0.92;
}

/* Secondary = transparent with --ink-border outline */
.btn-secondary {
  background: transparent;
  color: var(--ink-text);
  border-color: var(--ink-border);
  box-shadow: none;
}

.btn-secondary:hover:not(:disabled) {
  background: var(--ink-panel);
  border-color: var(--ink-border);
  color: var(--ink-text);
}

/* Destructive/alert actions use --signal-alert as a solid fill */
.btn-danger {
  background: var(--signal-alert);
  color: #FFFFFF;
  border-color: var(--signal-alert);
  box-shadow: none;
}

.btn-danger:hover:not(:disabled) {
  transform: none;
  box-shadow: none;
  opacity: 0.92;
}

/* General Technical Instrument Panel Utilities */
.text-mono {
  font-family: var(--font-mono);
}

.text-display {
  font-family: var(--font-display);
}

.signal-alert {
  color: var(--signal-alert);
}

.signal-good {
  color: var(--signal-good);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 0.75rem;
  margin-bottom: 0.75rem;
  border-bottom: 1px solid var(--ink-border);
  font-family: var(--font-display);
}
</file>

<file path="src/pages/Dashboard.tsx">
import React, { useEffect, useState } from 'react';
import { send, onMessage } from '../lib/channel';
import type { SyncMessage } from '../types/messages';
import { useVisionFeed } from '../lib/hooks/useVisionFeed';
import { ShieldAlert } from 'lucide-react';

export const Dashboard: React.FC = () => {
  const {
    videoRef,
    canvasRef,
    cameraActive,
    cameraError,
    pipelineReady,
    pipelineLoading,
    pipelineError,
    poseDetected,
    measuredFps,
    postureMetrics,
    postureClassification
  } = useVisionFeed({ active: true });

  // Broadcast Log State
  const [lastSentMessage, setLastSentMessage] = useState<string>('None yet');
  const [receivedMessages, setReceivedMessages] = useState<string[]>([]);

  // Listen for cross-tab messages (e.g., DEMO_READY)
  useEffect(() => {
    const unsubscribe = onMessage((msg: SyncMessage) => {
      const timestamp = new Date().toLocaleTimeString();
      setReceivedMessages((prev) => [
        `[${timestamp}] Received: ${msg.type} ${JSON.stringify(msg)}`,
        ...prev.slice(0, 9)
      ]);
    });

    return () => {
      unsubscribe();
    };
  }, []);

  const handleSendTestSignal = () => {
    const msg: SyncMessage = {
      type: 'POSTURE_STATUS',
      status: 'slouching',
      severity: 2
    };
    send(msg);
    setLastSentMessage(`POSTURE_STATUS (slouching, severity: 2) at ${new Date().toLocaleTimeString()}`);
  };

  const handleSendClear = () => {
    const msg: SyncMessage = {
      type: 'CLEAR_INTERVENTION'
    };
    send(msg);
    setLastSentMessage(`CLEAR_INTERVENTION at ${new Date().toLocaleTimeString()}`);
  };

  return (
    <div style={{ maxWidth: '1240px', margin: '2rem auto 4rem', padding: '0 1.5rem', fontFamily: 'var(--font-display)' }}>
      {/* Header bar */}
      <div style={{ display: 'flex', alignItems: 'baseline', justifyContent: 'space-between', marginBottom: '1.5rem', flexWrap: 'wrap', gap: '1rem', borderBottom: '1px solid var(--ink-border)', paddingBottom: '1rem' }}>
        <div>
          <div style={{ display: 'flex', alignItems: 'center', gap: '1.25rem', flexWrap: 'wrap' }}>
            <h1 style={{ fontSize: '1.4rem', fontWeight: 600, color: 'var(--ink-text)', margin: 0 }}>
              POSTURE MONITOR READOUT
            </h1>

            {/* Status indicators: plain --font-mono labels preceded by small square indicator */}
            <div style={{ display: 'flex', alignItems: 'center', gap: '1rem', fontFamily: 'var(--font-mono)', fontSize: '0.75rem', letterSpacing: '0.04em' }}>
              <span style={{ display: 'inline-flex', alignItems: 'center', gap: '0.45rem', color: cameraActive ? 'var(--ink-text)' : 'var(--ink-muted)' }}>
                <span style={{
                  width: '6px',
                  height: '6px',
                  backgroundColor: cameraActive ? 'var(--signal-good)' : 'var(--signal-alert)',
                  display: 'inline-block'
                }} />
                {cameraActive ? 'CAMERA: LIVE' : 'CAMERA: OFF'}
              </span>

              <span style={{ display: 'inline-flex', alignItems: 'center', gap: '0.45rem', color: pipelineReady ? 'var(--ink-text)' : 'var(--ink-muted)' }}>
                <span style={{
                  width: '6px',
                  height: '6px',
                  backgroundColor: pipelineReady ? 'var(--signal-good)' : pipelineLoading ? 'var(--ink-muted)' : 'var(--signal-alert)',
                  display: 'inline-block'
                }} />
                {pipelineReady ? 'MEDIAPIPE: READY' : pipelineLoading ? 'MEDIAPIPE: INITIALIZING' : 'MEDIAPIPE: ERROR'}
              </span>
            </div>
          </div>

          <p style={{ color: 'var(--ink-muted)', fontSize: '0.8rem', fontFamily: 'var(--font-mono)', marginTop: '0.5rem', margin: 0 }}>
            BROADCAST CHANNEL : <span style={{ color: 'var(--ink-text)' }}>posturesync</span> (same-origin)
          </p>
        </div>
      </div>

      {/* Main 2-Column Grid */}
      <div style={{ display: 'grid', gridTemplateColumns: 'minmax(0, 1.35fr) minmax(0, 1fr)', gap: '1.5rem' }}>
        {/* Left Column: Live Webcam View with Canvas Landmark Overlay */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: '1.5rem' }}>
          <div className="glass-panel" style={{ padding: '1.25rem', display: 'flex', flexDirection: 'column' }}>
            <div className="panel-header" style={{ marginBottom: '1rem' }}>
              <span style={{ fontFamily: 'var(--font-mono)', fontSize: '0.75rem', letterSpacing: '0.06em', color: 'var(--ink-text)' }}>
                OPTICAL FEED // GEOMETRY OVERLAY
              </span>
              <span style={{ fontFamily: 'var(--font-mono)', fontSize: '0.75rem', color: 'var(--ink-muted)' }}>
                LOCAL WASM
              </span>
            </div>

            <div style={{
              position: 'relative',
              width: '100%',
              backgroundColor: '#071220',
              borderRadius: '2px',
              overflow: 'hidden',
              aspectRatio: '16 / 9',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              border: '1px solid var(--ink-border)'
            }}>
              {cameraError ? (
                <div style={{ textAlign: 'center', padding: '1.5rem', color: 'var(--signal-alert)' }}>
                  <ShieldAlert size={32} style={{ margin: '0 auto 0.5rem' }} />
                  <p style={{ fontWeight: 600, fontFamily: 'var(--font-mono)', fontSize: '0.85rem' }}>CAMERA ACCESS ERROR</p>
                  <p style={{ fontSize: '0.8rem', color: 'var(--ink-muted)', marginTop: '0.25rem' }}>{cameraError}</p>
                </div>
              ) : pipelineError ? (
                <div style={{ textAlign: 'center', padding: '1.5rem', color: 'var(--signal-alert)' }}>
                  <ShieldAlert size={32} style={{ margin: '0 auto 0.5rem' }} />
                  <p style={{ fontWeight: 600, fontFamily: 'var(--font-mono)', fontSize: '0.85rem' }}>MEDIAPIPE ERROR</p>
                  <p style={{ fontSize: '0.8rem', color: 'var(--ink-muted)', marginTop: '0.25rem' }}>{pipelineError}</p>
                </div>
              ) : (
                <>
                  <video
                    ref={videoRef}
                    autoPlay
                    playsInline
                    muted
                    style={{
                      width: '100%',
                      height: '100%',
                      objectFit: 'cover',
                      transform: 'scaleX(-1)'
                    }}
                  />
                  <canvas
                    ref={canvasRef}
                    style={{
                      position: 'absolute',
                      inset: 0,
                      width: '100%',
                      height: '100%',
                      objectFit: 'cover',
                      transform: 'scaleX(-1)',
                      pointerEvents: 'none'
                    }}
                  />
                </>
              )}
            </div>

            <div style={{
              marginTop: '0.85rem',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              fontFamily: 'var(--font-mono)',
              fontSize: '0.75rem',
              color: 'var(--ink-muted)'
            }}>
              <span>INFERENCE RATE : <span style={{ color: 'var(--ink-text)' }}>{measuredFps} FPS</span></span>
              <span>{poseDetected ? '33 LANDMARKS ACTIVE' : 'NO SUBJECT DETECTED'}</span>
            </div>
          </div>

          {/* Cross-Tab Signal Controls */}
          <div className="glass-panel" style={{ padding: '1.25rem' }}>
            <div className="panel-header">
              <span style={{ fontFamily: 'var(--font-mono)', fontSize: '0.75rem', letterSpacing: '0.06em', color: 'var(--ink-text)' }}>
                TELEMETRY BUS CONTROL
              </span>
              <span style={{ fontFamily: 'var(--font-mono)', fontSize: '0.75rem', color: 'var(--ink-muted)' }}>
                SIMULATION
              </span>
            </div>
            <p style={{ fontSize: '0.85rem', color: 'var(--ink-muted)', marginBottom: '1rem', lineHeight: 1.5 }}>
              Transmit test signal events over <span style={{ fontFamily: 'var(--font-mono)', color: 'var(--ink-text)' }}>BroadcastChannel</span> to verify target workspace reactions.
            </p>

            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '0.75rem' }}>
              <button
                id="btn-send-test-signal"
                className="btn btn-danger"
                onClick={handleSendTestSignal}
              >
                Send Test (Slouching 2)
              </button>

              <button
                id="btn-clear-intervention"
                className="btn btn-secondary"
                onClick={handleSendClear}
              >
                Clear Intervention
              </button>
            </div>

            <div style={{
              marginTop: '0.85rem',
              padding: '0.5rem 0.75rem',
              borderRadius: '2px',
              background: 'var(--ink-bg)',
              fontSize: '0.75rem',
              fontFamily: 'var(--font-mono)',
              border: '1px solid var(--ink-border)'
            }}>
              <span style={{ color: 'var(--ink-muted)' }}>LAST EMITTED // </span>
              <span style={{ color: 'var(--ink-text)' }}>{lastSentMessage}</span>
            </div>
          </div>
        </div>

        {/* Right Column: Real-Time Posture Analytics, Classifier & Visibility Debug */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: '1.5rem' }}>
          {/* Posture Classification Status Card */}
          <div className="glass-panel" style={{ padding: '1.25rem' }}>
            <div className="panel-header" style={{ alignItems: 'baseline' }}>
              <span style={{ fontFamily: 'var(--font-mono)', fontSize: '0.75rem', letterSpacing: '0.06em', color: 'var(--ink-text)' }}>
                POSTURE INTELLIGENCE CLASSIFIER
              </span>

              {/* Bracketed --font-mono label style */}
              <span style={{
                fontFamily: 'var(--font-mono)',
                fontSize: '0.75rem',
                fontWeight: 600,
                letterSpacing: '0.06em',
                color:
                  postureClassification.status === 'good' ? 'var(--signal-good)' :
                  postureClassification.status === 'insufficient_data' ? 'var(--ink-muted)' :
                  'var(--signal-alert)'
              }}>
                [ {postureClassification.status.toUpperCase().replace('_', ' ')}{postureClassification.severity > 0 ? ` · SEV ${postureClassification.severity}` : ''} ]
              </span>
            </div>

            {/* Diagnostic Reason */}
            <div style={{
              padding: '0.65rem 0.85rem',
              borderRadius: '2px',
              background: 'var(--ink-bg)',
              fontSize: '0.8rem',
              fontFamily: 'var(--font-mono)',
              color: 'var(--ink-muted)',
              marginBottom: '1rem',
              border: '1px solid var(--ink-border)'
            }}>
              <span style={{ color: 'var(--ink-text)' }}>DIAGNOSIS : </span>
              {postureClassification.reason}
            </div>

            {/* Live Metrics Grid with 3px left border-accent stripe on threshold breach */}
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: '0.75rem' }}>
              {/* Lateral Tilt */}
              {(() => {
                const isBreached = (postureMetrics?.lateralTiltDeg ?? 0) >= 6;
                return (
                  <div style={{
                    padding: '0.65rem 0.75rem',
                    borderRadius: '2px',
                    background: 'var(--ink-bg)',
                    border: '1px solid var(--ink-border)',
                    borderLeft: isBreached ? '3px solid var(--signal-alert)' : '1px solid var(--ink-border)'
                  }}>
                    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', color: 'var(--ink-muted)', fontSize: '0.7rem', fontFamily: 'var(--font-mono)', marginBottom: '0.25rem' }}>
                      <span>LATERAL TILT</span>
                      {isBreached && <span style={{ color: 'var(--signal-alert)', fontSize: '0.65rem' }}>WARN</span>}
                    </div>
                    <div style={{ fontSize: '1.15rem', fontFamily: 'var(--font-mono)', fontWeight: 500, color: isBreached ? 'var(--signal-alert)' : 'var(--ink-text)' }}>
                      {postureMetrics?.lateralTiltDeg !== null && postureMetrics?.lateralTiltDeg !== undefined
                        ? `${postureMetrics.lateralTiltDeg}°`
                        : '—'}
                      {postureMetrics?.leanDirection !== 'neutral' && postureMetrics?.lateralTiltDeg !== null && postureMetrics?.lateralTiltDeg !== undefined ? (
                        <span style={{ fontSize: '0.75rem', color: 'var(--ink-muted)', marginLeft: '6px' }}>({postureMetrics?.leanDirection})</span>
                      ) : null}
                    </div>
                  </div>
                );
              })()}

              {/* Shoulder Tilt */}
              {(() => {
                const isBreached = (postureMetrics?.shoulderTiltDeg ?? 0) >= 5;
                return (
                  <div style={{
                    padding: '0.65rem 0.75rem',
                    borderRadius: '2px',
                    background: 'var(--ink-bg)',
                    border: '1px solid var(--ink-border)',
                    borderLeft: isBreached ? '3px solid var(--signal-alert)' : '1px solid var(--ink-border)'
                  }}>
                    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', color: 'var(--ink-muted)', fontSize: '0.7rem', fontFamily: 'var(--font-mono)', marginBottom: '0.25rem' }}>
                      <span>SHOULDER TILT</span>
                      {isBreached && <span style={{ color: 'var(--signal-alert)', fontSize: '0.65rem' }}>WARN</span>}
                    </div>
                    <div style={{ fontSize: '1.15rem', fontFamily: 'var(--font-mono)', fontWeight: 500, color: isBreached ? 'var(--signal-alert)' : 'var(--ink-text)' }}>
                      {postureMetrics?.shoulderTiltDeg !== null && postureMetrics?.shoulderTiltDeg !== undefined
                        ? `${postureMetrics.shoulderTiltDeg}°`
                        : '—'}
                    </div>
                  </div>
                );
              })()}

              {/* Head Forward Offset */}
              {(() => {
                const isBreached = (postureMetrics?.headForwardOffset ?? 0) >= 0.16;
                return (
                  <div style={{
                    padding: '0.65rem 0.75rem',
                    borderRadius: '2px',
                    background: 'var(--ink-bg)',
                    border: '1px solid var(--ink-border)',
                    borderLeft: isBreached ? '3px solid var(--signal-alert)' : '1px solid var(--ink-border)'
                  }}>
                    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', color: 'var(--ink-muted)', fontSize: '0.7rem', fontFamily: 'var(--font-mono)', marginBottom: '0.25rem' }}>
                      <span>HEAD OFFSET</span>
                      {isBreached && <span style={{ color: 'var(--signal-alert)', fontSize: '0.65rem' }}>WARN</span>}
                    </div>
                    <div style={{ fontSize: '1.15rem', fontFamily: 'var(--font-mono)', fontWeight: 500, color: isBreached ? 'var(--signal-alert)' : 'var(--ink-text)' }}>
                      {postureMetrics?.headForwardOffset !== null && postureMetrics?.headForwardOffset !== undefined
                        ? postureMetrics.headForwardOffset
                        : '—'}
                    </div>
                  </div>
                );
              })()}

              {/* Head Torso Angle */}
              {(() => {
                const isBreached = (postureMetrics?.headTorsoAngleDeg ?? 0) >= 18;
                return (
                  <div style={{
                    padding: '0.65rem 0.75rem',
                    borderRadius: '2px',
                    background: 'var(--ink-bg)',
                    border: '1px solid var(--ink-border)',
                    borderLeft: isBreached ? '3px solid var(--signal-alert)' : '1px solid var(--ink-border)'
                  }}>
                    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', color: 'var(--ink-muted)', fontSize: '0.7rem', fontFamily: 'var(--font-mono)', marginBottom: '0.25rem' }}>
                      <span>HEAD-TORSO ANGLE</span>
                      {isBreached && <span style={{ color: 'var(--signal-alert)', fontSize: '0.65rem' }}>WARN</span>}
                    </div>
                    <div style={{ fontSize: '1.15rem', fontFamily: 'var(--font-mono)', fontWeight: 500, color: isBreached ? 'var(--signal-alert)' : 'var(--ink-text)' }}>
                      {postureMetrics?.headTorsoAngleDeg !== null && postureMetrics?.headTorsoAngleDeg !== undefined
                        ? `${postureMetrics.headTorsoAngleDeg}°`
                        : '—'}
                    </div>
                  </div>
                );
              })()}
            </div>

            {/* Confidence & Landmark Health Bar */}
            <div style={{
              display: 'flex',
              justifyContent: 'space-between',
              alignItems: 'center',
              marginTop: '0.85rem',
              padding: '0.5rem 0.75rem',
              borderRadius: '2px',
              background: 'var(--ink-bg)',
              fontSize: '0.75rem',
              fontFamily: 'var(--font-mono)',
              border: '1px solid var(--ink-border)'
            }}>
              <div>
                <span style={{ color: 'var(--ink-muted)' }}>CONFIDENCE // </span>
                <span style={{ color: (postureMetrics?.confidence ?? 0) > 0.4 ? 'var(--signal-good)' : 'var(--ink-muted)' }}>
                  {postureMetrics ? `${Math.round(postureMetrics.confidence * 100)}%` : '0%'}
                </span>
              </div>
              <div>
                <span style={{ color: 'var(--ink-muted)' }}>STATE // </span>
                <span style={{ color: poseDetected ? 'var(--signal-good)' : 'var(--ink-muted)' }}>
                  {poseDetected ? 'LOCKED' : 'SEARCHING'}
                </span>
              </div>
            </div>
          </div>

          {/* Developer Landmark Visibility Debug Table */}
          <div className="glass-panel" style={{ padding: '1.25rem' }}>
            <div className="panel-header">
              <span style={{ fontFamily: 'var(--font-mono)', fontSize: '0.75rem', letterSpacing: '0.06em', color: 'var(--ink-text)' }}>
                LANDMARK VISIBILITY MATRIX
              </span>
              <span style={{ fontFamily: 'var(--font-mono)', fontSize: '0.75rem', color: 'var(--ink-muted)' }}>
                RAW SCORE
              </span>
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: '0.5rem', fontFamily: 'var(--font-mono)', fontSize: '0.75rem' }}>
              {[
                { label: 'NOSE', val: postureMetrics?.visibilityDebug.nose },
                { label: 'L. EAR', val: postureMetrics?.visibilityDebug.leftEar },
                { label: 'R. EAR', val: postureMetrics?.visibilityDebug.rightEar },
                { label: 'L. SHOULDER', val: postureMetrics?.visibilityDebug.leftShoulder },
                { label: 'R. SHOULDER', val: postureMetrics?.visibilityDebug.rightShoulder },
                { label: 'L. HIP', val: postureMetrics?.visibilityDebug.leftHip },
                { label: 'R. HIP', val: postureMetrics?.visibilityDebug.rightHip },
                { label: 'CONFIDENCE', val: postureMetrics?.confidence !== undefined ? Number(postureMetrics.confidence.toFixed(2)) : undefined }
              ].map((item, idx) => {
                const numericVal = typeof item.val === 'number' ? item.val : null;
                const isGood = numericVal !== null && numericVal > 0.3;
                return (
                  <div
                    key={idx}
                    style={{
                      background: 'var(--ink-bg)',
                      padding: '0.4rem 0.55rem',
                      borderRadius: '2px',
                      border: '1px solid var(--ink-border)'
                    }}
                  >
                    <div style={{ color: 'var(--ink-muted)', fontSize: '0.65rem', marginBottom: '2px' }}>{item.label}</div>
                    <div style={{ color: isGood ? 'var(--signal-good)' : 'var(--ink-muted)' }}>
                      {item.val ?? 'N/A'}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          {/* Activity / Event Log */}
          <div className="glass-panel" style={{ padding: '1.25rem', display: 'flex', flexDirection: 'column' }}>
            <div className="panel-header">
              <span style={{ fontFamily: 'var(--font-mono)', fontSize: '0.75rem', letterSpacing: '0.06em', color: 'var(--ink-text)' }}>
                CHANNEL ACTIVITY LOG
              </span>
              <span style={{ fontFamily: 'var(--font-mono)', fontSize: '0.75rem', color: 'var(--ink-muted)' }}>
                EVENT BUS
              </span>
            </div>

            <div style={{
              minHeight: '75px',
              backgroundColor: 'var(--ink-bg)',
              borderRadius: '2px',
              padding: '0.65rem',
              fontSize: '0.72rem',
              fontFamily: 'var(--font-mono)',
              overflowY: 'auto',
              border: '1px solid var(--ink-border)',
              color: 'var(--ink-muted)'
            }}>
              {receivedMessages.length === 0 ? (
                <div style={{ color: 'var(--ink-muted)', fontStyle: 'italic' }}>No incoming channel events logged.</div>
              ) : (
                receivedMessages.map((msg, idx) => (
                  <div key={idx} style={{ marginBottom: '0.25rem', wordBreak: 'break-all', color: 'var(--ink-text)' }}>
                    {msg}
                  </div>
                ))
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};
</file>

