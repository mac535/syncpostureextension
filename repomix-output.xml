  .qp-discovery-grid {
    grid-template-columns: 1fr;
  }
  .qp-place-wide {
    grid-column: auto;
  }
}

/* ==========================================================
   QUIET PLACE JOURNAL SECTION
   ========================================================== */

.qp-journal-section {
  padding-top: var(--space-80);
  padding-bottom: var(--space-96);
  background-color: var(--qp-mint);
}

.qp-journal-header {
  margin-bottom: var(--space-48);
}

.qp-journal-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: var(--space-32);
}

@media (max-width: 960px) {
  .qp-journal-grid {
    grid-template-columns: 1fr;
  }
}

.qp-journal-card {
  background-color: var(--qp-cream-light);
  border: 1px solid var(--qp-border);
  border-radius: 18px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 250ms ease, box-shadow 250ms ease, border-color 250ms ease;
  cursor: pointer;
}

.qp-journal-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 28px -8px rgba(23, 59, 53, 0.08);
  border-color: rgba(23, 59, 53, 0.2);
}

.qp-journal-featured-art {
  width: 100%;
  overflow: hidden;
  background-color: var(--qp-sand);
}

.qp-journal-card:hover .qp-journal-featured-art svg {
  transform: scale(1.02);
}

.qp-journal-side-stack {
  display: flex;
  flex-direction: column;
  gap: var(--space-24);
}

.qp-journal-content {
  padding: var(--space-32);
  display: flex;
  flex-direction: column;
  flex: 1;
}

.qp-journal-meta {
  display: flex;
  align-items: center;
  gap: var(--space-16);
  margin-bottom: var(--space-12);
}

.qp-journal-cat {
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--qp-green-muted);
  text-transform: uppercase;
}

.qp-journal-time {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.8rem;
  color: var(--qp-forest-muted);
}

.qp-journal-title {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  line-height: 1.35;
  font-weight: 400;
  color: var(--qp-forest);
  margin-bottom: var(--space-12);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-12);
  transition: color 200ms ease;
}

.qp-journal-featured-title {
  font-size: 1.7rem;
}

.qp-journal-card:hover .qp-journal-title {
  color: var(--qp-coral);
}

.qp-journal-arrow {
  color: var(--qp-green-muted);
  opacity: 0.6;
  flex-shrink: 0;
  margin-top: 4px;
  transition: all 200ms ease;
}

.qp-journal-card:hover .qp-journal-arrow {
  opacity: 1;
  color: var(--qp-coral);
  transform: translate(2px, -2px);
}

.qp-journal-excerpt {
  font-size: 0.95rem;
  line-height: 1.6;
  color: var(--qp-forest-muted);
}

/* ==========================================================
   QUIET PLACE FINAL CTA SECTION
   ========================================================== */

.qp-cta-section {
  padding-top: var(--space-48);
  padding-bottom: var(--space-80);
  background-color: var(--qp-mint);
}

.qp-cta-box {
  background-color: var(--qp-forest);
  border-radius: 24px;
  position: relative;
  overflow: hidden;
  padding: var(--space-80) var(--space-32);
  text-align: center;
  box-shadow: 0 20px 40px -12px rgba(23, 59, 53, 0.25);
}

.qp-cta-decor {
  position: absolute;
  inset: 0;
  pointer-events: none;
  width: 100%;
  height: 100%;
}

.qp-cta-inner {
  position: relative;
  z-index: 2;
  max-width: 620px;
  margin: 0 auto;
}

.qp-cta-title {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 3.5vw, 2.75rem);
  line-height: 1.2;
  font-weight: 400;
  color: #FCFAF5;
  letter-spacing: -0.01em;
  margin-bottom: var(--space-16);
}

.qp-cta-desc {
  font-family: var(--font-sans);
  font-size: 1.1rem;
  line-height: 1.6;
  color: var(--qp-sage);
  margin-bottom: var(--space-32);
}

.qp-cta-btn-large {
  padding: 13px 32px;
  font-size: 1rem;
}

/* ==========================================================
   QUIET PLACE FOOTER SECTION
   ========================================================== */

.qp-footer-wrapper {
  background-color: var(--qp-cream-light);
  border-top: 1px solid var(--qp-border);
  padding-top: var(--space-64);
  padding-bottom: var(--space-48);
}

.qp-footer-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-48);
  margin-bottom: var(--space-48);
  flex-wrap: wrap;
}

.qp-footer-brand-col {
  max-width: 380px;
}

.qp-footer-tagline {
  font-size: 0.925rem;
  line-height: 1.6;
  color: var(--qp-forest-muted);
}

.qp-footer-links-grid {
  display: flex;
  gap: var(--space-64);
}

@media (max-width: 640px) {
  .qp-footer-links-grid {
    gap: var(--space-32);
  }
}

.qp-footer-col {
  display: flex;
  flex-direction: column;
  gap: var(--space-12);
}

.qp-footer-col-title {
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--qp-forest);
  margin-bottom: var(--space-4);
}

.qp-footer-link {
  font-size: 0.925rem;
  color: var(--qp-forest-muted);
  transition: color 150ms ease;
}

.qp-footer-link:hover {
  color: var(--qp-forest);
}

.qp-footer-bottom {
  border-top: 1px solid var(--qp-border-light);
  padding-top: var(--space-24);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-16);
}

.qp-footer-copy {
  font-size: 0.85rem;
  color: var(--qp-green-muted);
}

.qp-footer-meta-pill {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--qp-green-muted);
  background-color: var(--qp-sand);
  padding: 4px 10px;
  border-radius: 9999px;
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }

  /* Suppress vignette pulse and status dot pulse */
  .intervention-overlay {
    animation: none !important;
  }
  .nav-status-dot,
  .status-dot-pulse {
    animation: none !important;
  }
}

/* ==========================================================
   STATUS ROW — 4-state monitoring strip (Dashboard)
   ========================================================== */

.status-row {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  flex-wrap: wrap;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.05em;
}

.status-item {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.status-dot {
  width: 6px;
  height: 6px;
  flex-shrink: 0;
  display: inline-block;
}

.status-dot--good {
  background-color: var(--signal-good);
}

.status-dot--alert {
  background-color: var(--signal-alert);
}

.status-dot--muted {
  background-color: var(--ink-border);
}

.status-dot--pulse {
  animation: pulse-status 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.status-label--good {
  color: var(--signal-good);
}

.status-label--alert {
  color: var(--signal-alert);
}

.status-label--muted {
  color: var(--ink-muted);
}

.status-label--text {
  color: var(--ink-text);
}

/* ==========================================================
   METRIC CALLOUT — Large active step value display
   ========================================================== */

.metric-callout {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.metric-callout__label {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.06em;
  color: var(--ink-muted);
  text-transform: uppercase;
}

.metric-callout__value {
  font-family: var(--font-mono);
  font-size: 2rem;
  font-weight: 600;
  line-height: 1;
  transition: color 0.2s ease;
}

.metric-callout__value--good {
  color: var(--signal-good);
}

.metric-callout__value--alert {
  color: var(--signal-alert);
}

.metric-callout__value--muted {
  color: var(--ink-muted);
}

.metric-callout__limit {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--ink-muted);
  margin-top: 0.15rem;
}

/* ==========================================================
   SETUP STEP PROGRESS RAIL
   ========================================================== */

.setup-progress-rail {
  display: grid;
  gap: 0.4rem;
}

.setup-progress-rail__segment {
  height: 3px;
  border-radius: 1px;
  transition: background-color 0.3s ease;
}

.setup-progress-rail__segment--done {
  background-color: var(--signal-good);
}

.setup-progress-rail__segment--active {
  background-color: var(--ink-text);
}

.setup-progress-rail__segment--pending {
  background-color: var(--ink-border);
}

/* Step success flash */
.step-accepted-flash {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-family: var(--font-mono);
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--signal-good);
  letter-spacing: 0.04em;
  animation: flash-in 0.25s ease forwards;
}

@keyframes flash-in {
  from { opacity: 0; transform: translateY(-4px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ==========================================================
   DEMO — STATUS STRIP & RECOVERY BANNER
   ========================================================== */

/* Persistent monitoring status strip — fixed bottom-left, outside blur layer */
.demo-status-strip {
  position: fixed;
  bottom: 20px;
  left: 20px;
  z-index: 80;
  display: flex;
  flex-direction: column;
  gap: 4px;
  pointer-events: none;
}

.demo-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background-color: rgba(23, 59, 53, 0.88);
  border: 1px solid rgba(23, 59, 53, 0.25);
  border-radius: 6px;
  padding: 6px 12px;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  font-family: var(--font-mono, monospace);
  font-size: 0.72rem;
  letter-spacing: 0.05em;
  color: #DCEBE4;
  transition: opacity 0.4s ease;
}

.demo-status-pill--good {
  border-color: rgba(79, 216, 196, 0.3);
}

.demo-status-pill--alert {
  border-color: rgba(233, 111, 103, 0.4);
  color: #F4C5C1;
}

.demo-status-pip {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  flex-shrink: 0;
}

.demo-status-pip--good {
  background-color: #4FD8C4;
}

.demo-status-pip--alert {
  background-color: #E96F67;
}

.demo-status-pip--muted {
  background-color: rgba(120, 149, 139, 0.6);
}

/* Recovery / Restored banner — centered, above content */
.demo-recovery-banner {
  position: fixed;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 80;
  background-color: rgba(23, 59, 53, 0.9);
  border: 1px solid rgba(79, 216, 196, 0.4);
  border-radius: 8px;
  padding: 8px 20px;
  font-family: var(--font-mono, monospace);
  font-size: 0.75rem;
  letter-spacing: 0.06em;
  color: #4FD8C4;
  pointer-events: none;
  animation: banner-appear 0.3s ease forwards;
  white-space: nowrap;
}

@keyframes banner-appear {
  from { opacity: 0; transform: translateX(-50%) translateY(-6px); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}

/* ==========================================================
   DASHBOARD RESPONSIVE LAYOUT
   ========================================================== */

/* 2-column layout container — switches to 1-col at 1024px */
.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
  gap: 1.5rem;
}

@media (max-width: 1060px) {
  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

/* Dashboard outer wrapper with responsive padding */
.dashboard-wrapper {
  max-width: 1240px;
  margin: 1.75rem auto 4rem;
  padding: 0 1.5rem;
  font-family: var(--font-display);
}

@media (max-width: 640px) {
  .dashboard-wrapper {
    padding: 0 1rem;
    margin-top: 1.25rem;
  }
}

/* Dashboard header bar — wraps gracefully on small screens */
.dashboard-header-bar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
  gap: 1rem;
  border-bottom: 1px solid var(--ink-border);
  padding-bottom: 1rem;
}

@media (max-width: 640px) {
  .dashboard-header-bar {
    flex-direction: column;
    align-items: stretch;
    gap: 0.85rem;
  }
}

/* Setup wizard responsive font scaling */
@media (max-width: 540px) {
  .setup-step-title {
    font-size: 1.15rem !important;
  }
  .metric-callout__value {
    font-size: 1.5rem;
  }
}

/* Two-tab architecture diagram shown in step 5 completion */
.two-tab-diagram {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 0.75rem;
  align-items: center;
  padding: 1rem;
  background: var(--ink-bg);
  border: 1px solid var(--ink-border);
  border-radius: 4px;
}

.tab-box {
  padding: 0.65rem 0.85rem;
  border: 1px solid var(--ink-border);
  border-radius: 3px;
  text-align: center;
}

.tab-box--active {
  border-color: var(--signal-good);
  background: rgba(79, 216, 196, 0.06);
}

.tab-box__label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.06em;
  color: var(--ink-muted);
  margin-bottom: 0.2rem;
}

.tab-box__name {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--ink-text);
}

.tab-box__status {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--signal-good);
  margin-top: 0.2rem;
}

.tab-arrow {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--ink-muted);
  text-align: center;
}


/* ==========================================================
   DEGRADATION & BLUR INTERVENTION STYLING
   ========================================================== */

.demo-content-wrapper {
  /* filter is set via inline style from JS; this transition animates all changes smoothly */
  transition: filter 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  flex: 1;
  will-change: filter;
}

/* pointer-events/user-select are toggled inline when intensity > 0 */

.intervention-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* base vignette gradient; opacity driven by inline style */
  background: radial-gradient(circle, transparent 35%, rgba(233, 111, 103, 0.6) 100%);
  animation: pulse-vignette 2.4s infinite alternate ease-in-out;
  transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes pulse-vignette {
  0% {
    background: radial-gradient(circle, transparent 45%, rgba(233, 111, 103, 0.5) 100%);
  }
  100% {
    background: radial-gradient(circle, transparent 32%, rgba(233, 111, 103, 0.75) 100%);
  }
}

/* ==========================================================
   APP SHELL / DASHBOARD STYLING (Technical Instrument Panel)
   ========================================================== */

/* Flat technical panel: 1px hairline border, max 4px radius, no blur/glow */
.glass-panel {
  background: var(--ink-panel);
  border: 1px solid var(--ink-border);
  border-radius: 4px;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

/* Technical top navigation */
.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1.5rem;
  border-bottom: 1px solid var(--ink-border);
  background: var(--ink-bg);
  position: sticky;
  top: 0;
  z-index: 40;
  font-family: var(--font-display);
}

/* Technical brand badge - plain font-mono wordmark in --ink-text */
.brand-badge {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-weight: 500;
  font-size: 1rem;
  letter-spacing: -0.02em;
  color: var(--ink-text);
  background: none;
  -webkit-background-clip: unset;
  -webkit-text-fill-color: var(--ink-text);
  text-decoration: none;
}

/* Status indicator: 6px dot in --signal-good with subtle pulse */
.nav-status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: var(--signal-good);
  display: inline-block;
  animation: pulse-status 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes pulse-status {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.45;
    transform: scale(0.85);
  }
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

/* Nav links: 1px bottom-border underline on hover/active, --font-display, no background fill */
.nav-link {
  padding: 0.4rem 0;
  border-radius: 0;
  border: none;
  border-bottom: 1px solid transparent;
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--ink-muted);
  background: transparent !important;
  transition: color 0.15s ease, border-color 0.15s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
}

.nav-link:hover {
  color: var(--ink-text);
  border-bottom-color: var(--ink-text);
}

.nav-link.active {
  color: var(--ink-text);
  border-bottom-color: var(--ink-text);
}

.nav-link svg {
  color: var(--ink-muted);
  transition: color 0.15s ease;
}

.nav-link:hover svg,
.nav-link.active svg {
  color: var(--ink-text);
}

/* Technical buttons: flat, 1px border, max 4px radius, no gradients, no glows */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 600;
  border-radius: 4px;
  border: 1px solid transparent;
  cursor: pointer;
  transition: opacity 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  box-shadow: none;
  text-decoration: none;
}

.btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

/* Primary = solid --ink-text background with --ink-bg text (inverted, high contrast) */
.btn-primary {
  background: var(--ink-text);
  color: var(--ink-bg);
  border-color: var(--ink-text);
  box-shadow: none;
}

.btn-primary:hover:not(:disabled) {
  transform: none;
  box-shadow: none;
  opacity: 0.92;
}

/* Secondary = transparent with --ink-border outline */
.btn-secondary {
  background: transparent;
  color: var(--ink-text);
  border-color: var(--ink-border);
  box-shadow: none;
}

.btn-secondary:hover:not(:disabled) {
  background: var(--ink-panel);
  border-color: var(--ink-border);
  color: var(--ink-text);
}

/* Destructive/alert actions use --signal-alert as a solid fill */
.btn-danger {
  background: var(--signal-alert);
  color: #FFFFFF;
  border-color: var(--signal-alert);
  box-shadow: none;
}

.btn-danger:hover:not(:disabled) {
  transform: none;
  box-shadow: none;
  opacity: 0.92;
}

/* General Technical Instrument Panel Utilities */
.text-mono {
  font-family: var(--font-mono);
}

.text-display {
  font-family: var(--font-display);
}

.signal-alert {
  color: var(--signal-alert);
}

.signal-good {
  color: var(--signal-good);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 0.75rem;
  margin-bottom: 0.75rem;
  border-bottom: 1px solid var(--ink-border);
  font-family: var(--font-display);
}
