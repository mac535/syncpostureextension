          role="region"
          aria-label="Posture verified. Ready to launch demo workspace."
        >
          {/* Verified headline */}
          <div>
            <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem', marginBottom: '0.4rem' }}>
              <span
                style={{
                  width: '6px',
