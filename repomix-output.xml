            aria-live="polite"
            aria-atomic="true"
          >
            {step.metricValue}
          </div>
          <div className="metric-callout__limit">{step.metricLimit}</div>
        </div>

        {/* Status chip */}
        <div style={{ marginLeft: 'auto' }}>
          {acceptedFlash ? (
            <span className="step-accepted-flash" role="status">
              &#10003; {acceptedFlash}
            </span>
          ) : (
            <span
              style={{
                fontFamily: 'var(--font-mono)',
                fontSize: '0.72rem',
                fontWeight: 600,
                letterSpacing: '0.05em',
                color: step.isAccepted ? 'var(--signal-good)' : 'var(--ink-muted)',
                display: 'flex',
                alignItems: 'center',
                gap: '0.4rem',
              }}
              role="status"
            >
              <span
                style={{
                  width: '5px',
                  height: '5px',
                  borderRadius: '50%',
